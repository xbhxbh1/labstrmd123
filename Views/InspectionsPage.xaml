<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentCabinetMVVM.Views.InspectionsPage"
             x:Name="InspectionsRoot"
             Title="Акти огляду аудиторій">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

        <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center">
            <Button Text="Новий акт"
                    Command="{Binding NewInspectionCommand}"
                    AutomationId="NewInspectionButton"
                    Margin="0,0,8,6" />
        </FlexLayout>

        <Label Grid.Row="1"
               Text="{Binding Status}"
               AutomationId="InspectionsStatusLabel" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Inspections}"
                        AutomationId="InspectionsCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,6" ColumnDefinitions="64,*,Auto,Auto" ColumnSpacing="8">
                        <Image Source="{Binding PhotoPath}"
                               IsVisible="{Binding HasPhoto}"
                               WidthRequest="56"
                               HeightRequest="56"
                               Aspect="AspectFill"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding RoomNumber, StringFormat='Аудиторія {0}'}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding InspectedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="12" />
                            <Label Text="{Binding Description}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding LocationText}"
                                   FontSize="11"
                                   Opacity="0.7" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="Детальніше"
                                Command="{Binding BindingContext.OpenDetailsCommand, Source={x:Reference InspectionsRoot}}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3"
                                Text="На карті"
                                IsEnabled="{Binding HasLocation}"
                                Command="{Binding BindingContext.ShowOnMapCommand, Source={x:Reference InspectionsRoot}}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
