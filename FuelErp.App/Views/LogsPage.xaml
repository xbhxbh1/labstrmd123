<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:FuelErp.Converters"
             x:Class="FuelErp.Views.LogsPage"
             Title="Журнал подій">

    <ContentPage.Resources>
        <conv:LogLevelColorConverter x:Key="LogLevelColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <Label Grid.Row="0"
               Text="Локальний журнал застосунку"
               FontSize="20"
               FontAttributes="Bold" />

        <FlexLayout Grid.Row="1" Wrap="Wrap" AlignItems="Center">
            <Label Text="Рівень (і вище):" VerticalOptions="Center" Margin="0,0,8,0" />
            <Picker AutomationId="LogLevelPicker"
                    ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding SelectedLevel}"
                    WidthRequest="150"
                    Margin="0,0,16,0" />
            <Label Text="Записів:" VerticalOptions="Center" Margin="0,0,8,0" />
            <Picker AutomationId="LogCountPicker"
                    ItemsSource="{Binding Counts}"
                    SelectedItem="{Binding SelectedCount}"
                    WidthRequest="90"
                    Margin="0,0,16,0" />
            <Button AutomationId="RefreshLogsButton"
                    Text="Оновити"
                    Command="{Binding RefreshCommand}" />
        </FlexLayout>

        <CollectionView Grid.Row="2"
                        AutomationId="LogsCollection"
                        ItemsSource="{Binding Entries}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="0,3">
                        <Label Text="{Binding Header}"
                               FontSize="12"
                               TextColor="{Binding Level, Converter={StaticResource LogLevelColorConverter}}" />
                        <Label Text="{Binding Details}"
                               FontSize="10"
                               Opacity="0.7"
                               IsVisible="{Binding HasDetails}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Label Text="{Binding Status}" FontSize="12" />
            <BoxView HeightRequest="1" Color="LightGray" />
            <Label Text="Діагностика" FontAttributes="Bold" />

            <FlexLayout Wrap="Wrap">
                <Button Text="Виняток у фоновій задачі"
                        Command="{Binding SimulateTaskExceptionCommand}"
                        Margin="0,0,8,6" />
                <Button Text="Надіслати тестовий звіт"
                        Command="{Binding SendTestReportCommand}"
                        Margin="0,0,8,6" />
                <Button Text="Штучний краш"
                        Command="{Binding SimulateCrashCommand}"
                        Margin="0,0,8,6" />
            </FlexLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Placeholder="Sentry DSN (https://...@...sentry.io/...)"
                       Text="{Binding Dsn}" />
                <Button Grid.Column="1"
                        Text="Зберегти DSN"
                        Command="{Binding SaveDsnCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
