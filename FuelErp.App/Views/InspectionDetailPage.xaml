<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FuelErp.Views.InspectionDetailPage"
             Title="Акт огляду">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="{Binding Inspection.RoomNumber, StringFormat='Аудиторія {0}'}"
                   FontSize="22"
                   FontAttributes="Bold"
                   AutomationId="DetailRoomLabel" />

            <Label Text="{Binding Inspection.InspectedAt, StringFormat='Дата огляду: {0:dd.MM.yyyy HH:mm}'}" />

            <Label Text="{Binding Inspection.Description}" />

            <Image Source="{Binding Inspection.PhotoPath}"
                   IsVisible="{Binding Inspection.HasPhoto}"
                   HeightRequest="240"
                   Aspect="AspectFit" />

            <Label Text="{Binding Inspection.LocationText}"
                   AutomationId="DetailLocationLabel" />

            <Button Text="Відкрити на карті"
                    IsEnabled="{Binding Inspection.HasLocation}"
                    Command="{Binding OpenOnMapCommand}"
                    AutomationId="OpenOnMapButton" />

            <Button Text="Назад"
                    Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
