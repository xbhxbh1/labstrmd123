<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FuelErp.Views.ReportPage"
             Title="Звіт витрат палива">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="8">
        <Label Text="Звіт витрат палива (лише бухгалтер)"
               FontSize="22"
               FontAttributes="Bold" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Lines}"
                        AutomationId="ReportCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                        <Label Text="{Binding FuelName}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Count, StringFormat='заправок: {0}'}" />
                        <Label Grid.Column="2" Text="{Binding LitersText}" />
                        <Label Grid.Column="3" Text="{Binding AmountText}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2"
               Text="{Binding TotalText}"
               FontAttributes="Bold"
               AutomationId="ReportTotalLabel" />

        <Button Grid.Row="3"
                Text="Назад"
                Command="{Binding GoBackCommand}"
                AutomationId="BackButton" />
    </Grid>
</ContentPage>
