<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FuelErp.Views.UsersPage"
             Title="Персонал (лише бухгалтер)">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Персонал (лише бухгалтер)"
               FontSize="22"
               FontAttributes="Bold" />

        <Label Text="{Binding Status}"
               AutomationId="UsersStatusLabel" />

        <CollectionView ItemsSource="{Binding Users}"
                        AutomationId="UsersCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Spacing="24" Padding="0,4">
                        <Label Text="{Binding Login}" WidthRequest="180" />
                        <Label Text="{Binding Role}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Назад"
                Command="{Binding GoBackCommand}" />
    </VerticalStackLayout>
</ContentPage>
