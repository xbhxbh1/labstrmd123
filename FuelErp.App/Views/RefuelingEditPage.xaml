<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FuelErp.Views.RefuelingEditPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">

            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Picker Title="Транспортний засіб"
                    ItemsSource="{Binding Vehicles}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                    AutomationId="VehiclePicker" />

            <Picker Title="Резервуар"
                    ItemsSource="{Binding Tanks}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedTank, Mode=TwoWay}"
                    AutomationId="TankPicker" />

            <Label Text="{Binding AvailableText}" FontSize="12" Opacity="0.8" />

            <Entry Placeholder="ПІБ водія"
                   Text="{Binding DriverName, Mode=TwoWay}"
                   AutomationId="DriverEntry" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Placeholder="Літрів"
                       Keyboard="Numeric"
                       Text="{Binding LitersText, Mode=TwoWay}"
                       AutomationId="LitersEntry" />
                <Entry Grid.Column="1"
                       Placeholder="Ціна за літр, грн"
                       Keyboard="Numeric"
                       Text="{Binding PriceText, Mode=TwoWay}"
                       AutomationId="PriceEntry" />
            </Grid>

            <Label Text="{Binding TotalText}"
                   FontAttributes="Bold"
                   AutomationId="TotalLabel" />

            <Editor Placeholder="Примітки"
                    Text="{Binding Notes, Mode=TwoWay}"
                    HeightRequest="80"
                    AutomationId="NotesEditor" />

            <Label Text="Фото чека або лічильника" FontAttributes="Bold" />
            <Image Source="{Binding ReceiptPhotoPath}"
                   IsVisible="{Binding HasPhoto}"
                   HeightRequest="160"
                   Aspect="AspectFit"
                   AutomationId="ReceiptPreview" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Зробити фото"
                        Command="{Binding TakePhotoCommand}"
                        AutomationId="TakePhotoButton" />
                <Button Text="З галереї"
                        Command="{Binding PickPhotoCommand}"
                        AutomationId="PickPhotoButton" />
            </HorizontalStackLayout>

            <Label Text="{Binding LocationText}" AutomationId="LocationLabel" />
            <Button Text="Визначити точку заправки"
                    Command="{Binding GetLocationCommand}"
                    AutomationId="GetLocationButton" />

            <Label Text="{Binding ValidationMessage}"
                   TextColor="OrangeRed"
                   AutomationId="ValidationLabel" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Зберегти"
                        Command="{Binding SaveCommand}"
                        AutomationId="SaveRefuelingButton" />
                <Button Text="Скасувати"
                        Command="{Binding CancelCommand}"
                        AutomationId="CancelButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
